# --- Frontend (Next.js) ---
# Next.js loads `.env.local`. Prisma CLI loads `.env` in /frontend — keep DATABASE_URL in sync in both files.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/unbiasedai?schema=public
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_DEMO_MODE=false

# Google OAuth (optional — omit to hide provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Demo password hash for credentials provider (optional)
# DEMO_USER_PASSWORD_HASH=

# --- Backend (FastAPI) ---
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=data/uploads
DEMO_MODE=false
RATE_LIMIT_AUDITS_PER_HOUR=10
REDIS_URL=
